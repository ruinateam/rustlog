{
  "openapi": "3.1.0",
  "info": {
    "title": "ChatTiers Rustlog API v2",
    "summary": "Versioned API for canonical Twitch ids and explicit query semantics.",
    "description": "v2 is additive and does not change legacy routes. Errors use `application/problem+json`; log ranges require both `from` and `to` in RFC 3339 format.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api/v2",
      "description": "Current rustlog instance, version 2 API"
    }
  ],
  "paths": {
    "/users/resolve": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Resolve a Twitch login",
        "description": "Resolve one Twitch login to the canonical numeric user id.",
        "operationId": "resolveUser",
        "parameters": [
          {
            "in": "query",
            "name": "login",
            "required": true,
            "schema": {
              "type": "string"
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolvedUser"
                }
              }
            }
          },
          "400": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "403": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "404": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "500": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "503": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/channels/{channel_id}/availability": {
      "get": {
        "tags": [
          "Logs"
        ],
        "summary": "List available log periods",
        "description": "List day buckets for a channel or month buckets for one canonical user id.",
        "operationId": "getChannelAvailability",
        "parameters": [
          {
            "in": "query",
            "name": "userId",
            "schema": {
              "type": [
                "string",
                "null"
              ]
            },
            "style": "form"
          }
        ],
        "responses": {
          "400": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "403": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "404": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "500": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "503": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/channels/{channel_id}/users/{user_id}/logs": {
      "get": {
        "tags": [
          "Logs"
        ],
        "summary": "Get user logs for an explicit range",
        "description": "Both RFC 3339 range endpoints are required. `from` is inclusive and `to` is exclusive.",
        "operationId": "getUserLogs",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "description": "RFC 3339 inclusive start timestamp.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "to",
            "description": "RFC 3339 exclusive end timestamp.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "format",
            "schema": {
              "$ref": "#/components/schemas/LogFormat"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "reverse",
            "description": "Return newest messages first.",
            "schema": {
              "type": "boolean"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "limit",
            "description": "Maximum number of messages to return.",
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 1
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "offset",
            "description": "Number of messages to skip.",
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "style": "form"
          }
        ],
        "responses": {
          "400": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "403": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "404": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "500": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "503": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResolveUserQuery": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          }
        },
        "required": [
          "login"
        ]
      },
      "ResolvedUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "login": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "login"
        ]
      },
      "ApiProblem": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "uint16",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "required": [
          "code",
          "status",
          "title"
        ]
      },
      "AvailabilityQuery": {
        "type": "object",
        "properties": {
          "userId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UserLogsQuery": {
        "type": "object",
        "properties": {
          "format": {
            "$ref": "#/components/schemas/LogFormat"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "reverse": {
            "type": "boolean",
            "default": false
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 1
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "LogFormat": {
        "type": "string",
        "enum": [
          "basic-json",
          "full-json",
          "ndjson",
          "text",
          "raw"
        ]
      }
    }
  }
}
