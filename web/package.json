{
  "name": "rustlog-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "api-types": "openapi-typescript ../docs/openapi/v2.json --output src/api/schema.d.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.48.0",
    "@tanstack/vue-query": "^5.104.0",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "openapi-fetch": "^0.17.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.5",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
