{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "4f2dbf033925c9f9e5e2e05d33ff9e64700b4972",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "rustlog",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value === 'rustlog' || @.name.value === 'rustlog-app' || @.name.value === 'rustlog-domain' || @.name.value === 'rustlog-storage' || @.name.value === 'rustlog-tools' || @.name.value === 'rustlog-twitch' || @.name.value === 'rustlog-web')].version" },
        { "type": "json", "path": "docs/openapi/legacy.json", "jsonpath": "$.info.version" },
        { "type": "json", "path": "docs/openapi/v2.json", "jsonpath": "$.info.version" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Refactoring" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "docs", "section": "Documentation" },
        { "type": "build", "section": "Build System" },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Miscellaneous", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true }
      ]
    }
  }
}
